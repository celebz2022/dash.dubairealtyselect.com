# Flask / private dashboard
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DASHBOARD_USER=replace-with-private-username
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
SESSION_COOKIE_SECURE=0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=replace-with-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-your-own-random-webhook-verify-token
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Recommended: Meta App Settings > Basic > App Secret
META_APP_SECRET=replace-with-meta-app-secret

# Local
DB_PATH=leads.db

# Railway example:
# DB_PATH=/data/leads.db
# SESSION_COOKIE_SECURE=1
